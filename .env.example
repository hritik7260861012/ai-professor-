# ---------------------------------------------------------------------------
# AI Professor Assistant — environment variables
#
# Copy this file to .env (gitignored) and adjust. Spring Boot does NOT read
# .env files automatically: export the variables in your shell, or configure
# them in your IDE run configuration. Vite reads VITE_* variables from .env
# inside frontend/ automatically.
# ---------------------------------------------------------------------------

# --- Backend (Spring Boot) -------------------------------------------------
# PostgreSQL / Supabase connection string.
# Local:        jdbc:postgresql://localhost:5432/professor_assistant
# Supabase:     jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/professor_assistant
SPRING_DATASOURCE_USERNAME=professor_assistant
SPRING_DATASOURCE_PASSWORD=change-me-in-real-deployments

# Server port
SERVER_PORT=8080

# Origins allowed to call the API (comma separated). The Vite dev server
# runs on 5173 by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (Vite) ---------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser bundle.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Phase 4: syllabus uploads ----------------------------------------------
# Private directory for uploaded syllabus files. Keep it OUTSIDE
# frontend/public so nothing can be served as a static asset, and point it
# at a dedicated volume in production.
# To clean up safely: stop the backend first, then delete this directory.
APP_SYLLABUS_STORAGE_DIR=./private-storage/syllabi

# Maximum accepted upload in bytes (default 10 MB).
APP_SYLLABUS_MAX_FILE_SIZE=10485760

# Servlet-level multipart ceiling. Keep slightly above the application limit
# so an oversized upload returns a friendly 400 rather than a raw 413.
APP_SYLLABUS_MAX_UPLOAD_SIZE=11MB

# Caps that bound extraction memory and time.
APP_SYLLABUS_MAX_CHARACTERS=500000
APP_SYLLABUS_MAX_PDF_PAGES=300
