# ---------------------------------------------------------------------------
# AI Professor Assistant — environment variables
#
# Copy this file to .env (gitignored) and adjust. Spring Boot does NOT read
# .env files automatically: export the variables in your shell, or configure
# them in your IDE run configuration. Vite reads VITE_* variables from .env
# inside frontend/ automatically.
# ---------------------------------------------------------------------------

# --- First administrator (LOCAL DEVELOPMENT ONLY) --------------------------
# There is deliberately no public admin-registration endpoint: public sign-up
# always creates a STUDENT. To obtain the very first ADMIN on a fresh local
# database, set the master switch plus the credentials BEFORE starting the
# backend. The switch defaults to false, so the credentials alone do nothing
# and leaving the variables set does not create accounts later.
#
# The account is created once. If an administrator already exists, or an
# account with the same email exists, nothing is changed and no password is
# reset. Supplying these variables on a real deployment is not recommended:
# leave the switch off and create administrators through the admin UI.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# LOCAL DEVELOPMENT ONLY. Resets the password of an account that ALREADY
# holds ADMIN, for when the original bootstrap password is lost.
# APP_BOOTSTRAP_ADMIN_ENABLED deliberately never overwrites an existing
# administrator, which is correct in production but can lock you out of
# your own local database. This is the only supported way back.
#
# Defaults to false, and the component does not even exist unless this is
# explicitly true. It never creates an account, only resets an existing
# ADMIN, and there is no HTTP endpoint for it. Switch it off again as soon
# as you have signed in.
APP_BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# --- Backend (Spring Boot) -------------------------------------------------
# PostgreSQL / Supabase connection string.
# Local:        jdbc:postgresql://localhost:5432/professor_assistant
# Supabase:     jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/professor_assistant
SPRING_DATASOURCE_USERNAME=professor_assistant
SPRING_DATASOURCE_PASSWORD=change-me-in-real-deployments

# Server port
SERVER_PORT=8080

# Origins allowed to call the API (comma separated). The Vite dev server
# runs on 5173 by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (Vite) ---------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser bundle.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Phase 4: syllabus uploads ----------------------------------------------
# Private directory for uploaded syllabus files. Keep it OUTSIDE
# frontend/public so nothing can be served as a static asset, and point it
# at a dedicated volume in production.
# To clean up safely: stop the backend first, then delete this directory.
APP_SYLLABUS_STORAGE_DIR=./private-storage/syllabi

# Maximum accepted upload in bytes (default 10 MB).
APP_SYLLABUS_MAX_FILE_SIZE=10485760

# Servlet-level multipart ceiling. Keep slightly above the application limit
# so an oversized upload returns a friendly 400 rather than a raw 413.
APP_SYLLABUS_MAX_UPLOAD_SIZE=11MB

# Caps that bound extraction memory and time.
APP_SYLLABUS_MAX_CHARACTERS=500000
APP_SYLLABUS_MAX_PDF_PAGES=300

# --- Phase 5: AI content generation ----------------------------------------
# Every variable below maps to `app.ai.*` in
# backend/src/main/resources/application.yml. Names and defaults are copied
# from that file.

# Provider selection: GEMINI (real) or MOCK (deterministic, for tests and local
# demos). MOCK is never selected automatically, so a production server with a
# missing key reports a configuration error instead of serving fake content.
APP_AI_PROVIDER=GEMINI

# Google Gemini API key. Read from the backend environment ONLY - never put it
# in frontend code, a VITE_* variable, a commit, or a log. Leave it empty and
# the app still starts; generation requests then return HTTP 503 with a clear
# message. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id. Gemini model names change often, so this is overridable without a
# rebuild. Pricing, free-tier availability and rate limits are set by Google
# and can change at any time - do not treat the free tier as unlimited.
APP_AI_MODEL=gemini-3.8-flash
APP_AI_BASE_URL=https://generativelanguage.googleapis.com
APP_AI_API_VERSION=v1beta
APP_AI_TIMEOUT_SECONDS=60

# Retry policy. Retries fire only for genuinely retryable failures (429, 5xx,
# timeout). Configuration and malformed-output errors fail immediately.
APP_AI_MAX_ATTEMPTS=3

# Cost and abuse guards. The daily quota is counted from the database and is
# advisory, NOT a billing-grade quota.
APP_AI_MAX_CONCURRENT_JOBS=2
APP_AI_MAX_CONCURRENT_PER_USER=1
APP_AI_DAILY_QUOTA=50

# Per-request bounds.
APP_AI_MAX_ITEMS=30
APP_AI_MAX_INSTRUCTION_LENGTH=500
APP_AI_MAX_CONTENT_CHARACTERS=200000

# A RUNNING job older than this is treated as stale and cancelled at startup.
APP_AI_STALE_JOB_MINUTES=15

# Window in which an identical resubmission reuses the existing job instead of
# paying for a second generation.
APP_AI_DUPLICATE_WINDOW_SECONDS=60
