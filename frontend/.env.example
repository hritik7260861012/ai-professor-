# Frontend environment variables.
# Only variables prefixed with VITE_ are bundled into the browser build.
# Copy to frontend/.env for local development.

# Base URL of the backend REST API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional: target used by the Vite dev-server proxy (see vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8080
